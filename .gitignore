# OS metadata
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Secrets
*.pem
.env
.env.local
.env.*.local

# User-provided staging area (reference images, drafts, etc.)
tmp/

# Claude Code per-machine state
.claude/

# Playwright scratch output
.playwright-mcp/

# Common toolchain caches, safe to keep here so adding any of these
# later doesn't require a second commit of ignore rules
node_modules/
.next/
.turbo/
.cache/
dist/
build/
coverage/
.eslintcache
.ruff_cache/
.mypy_cache/
.pytest_cache/
__pycache__/
*.pyc
.venv/
venv/

# TypeScript incremental build info
*.tsbuildinfo

# impeccable: the scratch is ignored, the design record is not. Critique logs
# and local build/live state never publish. config.json (the detector
# suppressions, each with the reason it was granted) and design.json (the
# tokens DESIGN.md's frontmatter cannot carry, if this repo ever grows one)
# are the design record and belong in review, so they are not listed here.
.impeccable/critique/
.impeccable/live/
.impeccable/build/
.impeccable/bin/
.impeccable/dist/
.impeccable/hook.*.json
.impeccable/config.local.json
